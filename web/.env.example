# Local development only (`npm run dev` against a running API). In production the
# dashboard runs in docker-compose and gets these values from the instance's .env.
# NEVER commit real values: copy to .env.local.

NEXT_PUBLIC_APP_NAME=Remouline
NEXT_PUBLIC_TIMEZONE=UTC

# Public URL of the dashboard (no trailing slash)
NEXTAUTH_URL=http://localhost:3000
# Session signing key: openssl rand -base64 48
NEXTAUTH_SECRET=

# Remouline API (internal network in production)
REMOULINE_API_URL=http://localhost:8080
# Same values as API_TOKEN / ADMIN_API_TOKEN in the instance's .env
REMOULINE_API_TOKEN=
REMOULINE_ADMIN_API_TOKEN=

# Try the UI without anything else: `npm run dev:mock` (fake users and data).
