# Remouline - VM environment (copy to .env, chmod 600, NEVER commit it).
# Generate secrets with: openssl rand -hex 32

APP_NAME=Remouline
# Time zone used to display dates in the dashboard (IANA name)
TIMEZONE=UTC

# ---- Domains (both through the Cloudflare Tunnel) ------------------------------
# Dashboard
APP_DOMAIN=app.example.com
# Git over HTTPS (Gitea). Only the Git protocol is reachable on this hostname.
GITEA_DOMAIN=git.example.com
GITEA_PUBLIC_URL=https://git.example.com
GITEA_INTERNAL_URL=http://gitea:3000

# ---- Cloudflare Tunnel (docs/DEPLOYMENT.md, step 4) ------------------------------
# "tunnel": run cloudflared in this compose project (tunnel/config.yml).
# Empty: a cloudflared already runs elsewhere; then publish the two services on the
# VM's address (e.g. 192.168.1.50:3080 and 192.168.1.50:3001) and firewall them.
COMPOSE_PROFILES=tunnel
WEB_PUBLISH=127.0.0.1:3080
GITEA_PUBLISH=127.0.0.1:3000

# ---- Secrets (see docs/DEPLOYMENT.md > Secrets) ----------------------------------
# HMAC secret shared between Gitea's system webhook and the webhook receiver
GITEA_WEBHOOK_SECRET=
# Gitea token of the operator account (a Gitea admin), scopes: write:admin, write:user, write:repository
GITEA_ADMIN_TOKEN=
# Gitea token used by the worker to clone pushes internally (read:repository)
GITEA_CLONE_TOKEN=
# Dashboard -> API, user routes
API_TOKEN=
# Dashboard -> API, admin routes
ADMIN_API_TOKEN=
# Signs the dashboard's session cookies: openssl rand -base64 48
NEXTAUTH_SECRET=

# ---- Roles --------------------------------------------------------------------
# Operator logins (comma-separated): they run the instance (accounts, access, logs,
# pause, legal pages). Use a neutral login. Maintainers, who import testsuites, are
# invited from Admin > Maintainers and get a generated pseudonymous login.
OPERATOR_LOGINS=operator

# ---- Storage (host paths) -------------------------------------------------------
REMOULINE_DATA=/srv/remouline/data
GITEA_DATA=/srv/remouline/gitea
REDIS_DATA=/srv/remouline/redis
# Must be identical on the host and inside the worker container
JOBS_DIR=/srv/remouline/jobs

# ---- Correction -------------------------------------------------------------------
RUNNER_IMAGE=remouline-runner
# FALLBACK only: every assignment has its own flags (remouline/flags.txt in its bundle,
# or set by a maintainer). The admin panel flags assignments still on this fallback.
# No -fsanitize=... here: every test already runs with AddressSanitizer and UBSan (such flags are ignored).
DEFAULT_COMPILE_FLAGS=-Wall -Wextra -Werror
# Parallel corrections per worker process (each container: 0.5 CPU / 256 MB)
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SEC=600
TEST_TIMEOUT_SEC=10
CONTAINER_MEMORY=256m
CONTAINER_CPUS=0.5
CONTAINER_PIDS=64
# Largest file a correction container may write (bytes)
CONTAINER_FSIZE_BYTES=67108864

# ---- Anti-spam (jobs over the limit are delayed, never dropped) ---------------------
MAX_RUNNING_PER_STUDENT=1
MAX_JOBS_PER_HOUR_PER_STUDENT=20
# Repositories a user can create with push-to-create
MAX_REPOS_PER_USER=30

# ---- Invitations ---------------------------------------------------------------------
INVITE_TTL_HOURS=72
# Default number of people each student can invite (changeable later in Admin > Access)
MAX_INVITES_PER_STUDENT=3

# ---- Data retention (days, 0 = disabled) ----------------------------------------------
# Pushes and results (days after the push) and Git repositories (days without a push)
DATA_RETENTION_DAYS=60
# Student accounts (with all their data) without any login or push
ACCOUNT_RETENTION_DAYS=180
# Logs, used/expired links, closed reports
LOG_RETENTION_DAYS=30
# Backups kept on the backup destination (used by scripts/backup.sh)
BACKUP_RETENTION_DAYS=30
